{
  "name": "cinkr-edge-router",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npx vitest@4.1.11 run",
    "test:watch": "npx vitest@4.1.11",
    "validate": "node scripts/validate-manifest.mjs",
    "manifest:generate": "node scripts/import-legacy-redirects.mjs \"../01-Cinkr home/dist/_redirects\" \"../03-Cinkr HMI/dist/_redirects\" \"../03-Cinkr HMI/dist\" \"../04-Cinkr HQD/dist/_redirects\" \"../04-Cinkr HQD/dist/hqd\" \"../05-CInkr MPG/dist/mpg/_redirects\" \"../05-CInkr MPG/dist/mpg\"",
    "pages:prepare:kinco": "node scripts/prepare-pages-upload.mjs \"../03-Cinkr HMI/dist\" kinco \".preview/pages/kinco\"",
    "pages:prepare:hqd": "node scripts/prepare-pages-upload.mjs \"../04-Cinkr HQD/dist\" hqd \".preview/pages/hqd\"",
    "pages:prepare:mpg": "node scripts/prepare-pages-upload.mjs \"../05-CInkr MPG/dist\" mpg \".preview/pages/mpg\"",
    "acceptance:production": "node scripts/crawl-acceptance.mjs https://cinkr.com/ --mode=production",
    "acceptance:staging": "node scripts/crawl-acceptance.mjs https://cinkr-edge-router-staging.atcspindle.workers.dev/ --mode=staging",
    "acceptance:richauto:production": "node scripts/acceptance-richauto-subdomain.mjs --routing",
    "acceptance:kinco:production": "node scripts/acceptance-kinco-subdomain.mjs --routing",
    "check": "npm run validate && npm run test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261014.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.3"
  }
}
